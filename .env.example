# Copy this file to .env and fill in real values there.
# Never put a real key in this file. It is safe to share.
# On Vercel, set these as Environment Variables in the project settings
# instead. The .env file is for running on your own PC.

# Free Gemini key from https://aistudio.google.com/apikey
# Leave it blank or as the placeholder to use the pre-written lines only.
GEMINI_API_KEY=your-gemini-key-here

# Optional. Any Gemini model your key can use. Default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Temperature: higher means more varied wording between clicks (0.0 to 1.0).
# This is the starting value. Visitors can change it on the page.
MOOD_TEMPERATURE=0.7
# Seconds to wait for Gemini before falling back to the pre-written lines (3 to 25).
MOOD_TIMEOUT_SECONDS=15
