# Copy this file to .env and fill in real values there.
# Never put a real key in this file. It is safe to share.

# Which provider to use: none, anthropic, openai or ollama
# "none" uses the pre-written response bank only. No key needed.
MOOD_PROVIDER=none

# Anthropic (only needed if MOOD_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (only needed if MOOD_PROVIDER=openai)
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama runs models on your own PC. No key needed.
# (only needed if MOOD_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Shared settings
# Temperature: higher means more varied wording between clicks.
MOOD_TEMPERATURE=0.7
# Seconds to wait for an API reply before falling back to the pre-written lines.
MOOD_TIMEOUT_SECONDS=15